{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@app/*": [
        "./src/app/*"
      ],
      "@library/*": [
        "./src/library/*"
      ],
      "@contracts/*": [
        "./src/contracts/*"
      ],
      "@config/*": [
        "./src/config/*"
      ],
      "@hooks/*": [
        "./src/library/frontend/hooks/*"
      ],
      "@scss/*": [
        "./src/library/frontend/scss/*"
      ],
      "@translations/*": [
        "./src/translations/*"
      ],
      "@design-system/*": [
        "./src/library/frontend/design-system/*"
      ],
      "@images/*": [
        "./public/images/*"
      ],
      "@downloads/*": [
        "./public/downloads/*"
      ],
      "@font/*": [
        "./public/fonts/*"
      ],
      "@locales/*": [
        "./public/locales/*"
      ]
    }
  }
}